<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>My tasks - TaskTracker</title>
  <meta name="description" content="List of your tasks in TaskTracker" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <header class="app-header py-2 mb-4">
    <nav class="container d-flex justify-content-between align-items-center">
      <a href="/dashboard" class="navbar-brand text-white">TaskTracker</a>
      <ul class="nav">
        <li class="nav-item">
          <a href="/dashboard" class="nav-link">Dashboard</a>
        </li>
        <li class="nav-item">
          <a href="/tasks" class="nav-link">Tasks</a>
        </li>
        <li class="nav-item">
          <a href="/profile" class="nav-link">Profile</a>
        </li>
        <li class="nav-item">
          <a href="/logout" class="nav-link">Logout</a>
        </li>
      </ul>
    </nav>
  </header>

  <main class="app-main container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h1 class="h3 mb-1">My tasks</h1>
        <p class="text-muted-custom mb-0">
          Manage your tasks and mark them as completed when you are done.
        </p>
      </div>
      <a href="/tasks/create" class="btn btn-primary">
        + Add task
      </a>
    </div>

    <form method="GET" action="/tasks" class="row g-2 mb-3">
      <div class="col-sm-4 col-md-3">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
        </select>
      </div>
      <div class="col-sm-4 col-md-3">
        <select name="priority" class="form-select">
          <option value="">All priorities</option>
          <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Low</option>
          <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Medium</option>
          <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>High</option>
        </select>
      </div>
      <div class="col-sm-4 col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">
          Filter
        </button>
      </div>
    </form>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (!tasks || tasks.length === 0) { %>
      <div class="alert alert-info">
        You do not have any tasks yet. Click "Add task" to create your first one.
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Category</th>
              <th>Deadline</th>
              <th style="width: 200px;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% tasks.forEach(task => { %>
              <tr>
                <td>
                  <% if (task.status === 'completed') { %>
                    <span class="text-muted text-decoration-line-through"><%= task.title %></span>
                  <% } else { %>
                    <%= task.title %>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-<%= task.status === 'completed' ? 'success' : 'secondary' %>">
                    <%= task.status %>
                  </span>
                </td>
                <td><%= task.priority %></td>
                <td><%= task.category || '-' %></td>
                <td>
                  <%= task.deadline ? task.deadline : '-' %>
                </td>
                <td>
                  <form method="POST" action="/tasks/<%= task.id %>/toggle-status" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-success">
                      <%= task.status === 'completed' ? 'Mark active' : 'Complete' %>
                    </button>
                  </form>

                  <a href="/tasks/<%= task.id %>/edit" class="btn btn-sm btn-outline-primary">
                    Edit
                  </a>

                  <form method="POST" action="/tasks/<%= task.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this task?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <footer class="app-footer mt-4 py-3">
    <div class="container text-center">
      <small>&copy; <%= new Date().getFullYear() %> TaskTracker</small>
    </div>
  </footer>
</body>
</html>
