<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Dashboard - TaskTracker</title>
  <meta name="description" content="Dashboard in TaskTracker app" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <header class="header py-2 mb-4">
    <nav class="container d-flex justify-content-between align-items-center">
      <a href="/dashboard" class="navbar-brand text-white">TaskTracker</a>
      <ul class="nav">
        <li class="nav-item">
          <a href="/dashboard" class="nav-link">Dashboard</a>
        </li>
        <li class="nav-item">
          <a href="/tasks" class="nav-link">Tasks</a>
        </li>
        <li class="nav-item">
          <a href="/profile" class="nav-link">Profile</a>
        </li>
        <li class="nav-item">
          <a href="/logout" class="nav-link">Logout</a>
        </li>
      </ul>
    </nav>
  </header>

  <main class="main container">
    <section class="mb-3">
      <h1 class="hero-title">
        Hello,
        <%= user && user.name ? user.name : (user && user.email ? user.email : 'there') %> 👋
      </h1>
      <p class="hero-subtitle">
        Here you can see your tasks for today.
      </p>
    </section>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <section class="grid">
      <div class="card">
        <div class="stat-label">Total tasks</div>
        <div class="stat-value"><%= stats.total %></div>
        <p class="muted mb-0">
          All tasks you have created so far.
        </p>
      </div>

      <div class="card">
        <div class="stat-label">Active</div>
        <div class="stat-value"><%= stats.active %></div>
        <p class="muted mb-0">
          Tasks that are still in progress.
        </p>
      </div>

      <div class="card">
        <div class="stat-label">Completed</div>
        <div class="stat-value"><%= stats.completed %></div>
        <p class="muted mb-0">
          Finished tasks. Good job!
        </p>
      </div>

      <div class="card">
        <div class="stat-label">Next deadline</div>

        <% if (stats.nextTask) { %>
          <div class="next-task-title">
            <%= stats.nextTask.title %>
          </div>
          <div class="next-task-deadline">
            <% if (stats.nextTask.deadline) { %>
              <%= stats.nextTask.deadline %>
            <% } %>
          </div>
          <p class="muted mb-0 mt-1">
            Don't forget to check your tasks.
          </p>
        <% } else { %>
          <p class="muted mb-0">
            You have no upcoming deadlines. You can add one more!
          </p>
        <% } %>
      </div>
    </section>

    <section class="grid mt-4">
      <div class="card">
        <div class="stat-label">Weather</div>

        <p class="muted mb-1">
          City:
          <strong id="weather-city">
            <%= user && user.city ? user.city : 'not set yet' %>
          </strong>
        </p>

        <div id="weather-content">
          <% if (!user || !user.city) { %>
            <p class="muted mb-0">
              Set your city on the Profile page to see the weather.
            </p>
          <% } else { %>
            <p class="muted mb-0">
              Loading weather for your city...
            </p>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer mt-4 py-3">
    <div class="container text-center">
      <small><%= new Date().getFullYear() %> TaskTracker</small>
    </div>
  </footer>

  <script src="/js/dashboard.js"></script>
</body>
</html>
